ENTRY(_start)

SECTIONS
{
    . = 0x0;
    .text :
    {
        __text_start = .;
        *(.text.boot) *(.text);
    }
    .rodata :
    {
        *(.rodata);
    }
    .rela :
    {
        __rela_start = .;
        *(.rela.*);
        __rela_end = .;
    }
    .data :
    {
        *(.data);
    }
    .bss :
    {
        __bss_start = .;
        *(.bss);
        __bss_end = .;
        /* Boot stack lives in its own nobits region after __bss_end so
           it survives zero_out_bss() running from within itself. */
        *(.boot_stack);
    }
    _image_end = .;
}
